# --- App ---
# Public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# 32-byte hex key used to AES-256-GCM encrypt Gmail refresh tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Database (Postgres: Neon / Supabase / local) ---
DATABASE_URL=postgres://user:password@localhost:5432/mailpilot

# --- Google OAuth (Cloud Console -> Credentials) ---
# Enable the Gmail API and add the gmail.modify scope to the consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail push notifications (Cloud Pub/Sub) ---
# Full topic name; grant gmail-api-push@system.gserviceaccount.com the
# Pub/Sub Publisher role on this topic. Leave empty in local dev to fall back
# to the 30-minute polling safety net.
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications
# Shared secret appended to the push subscription URL:
#   https://<app-domain>/api/gmail/push?token=<this value>
PUBSUB_VERIFICATION_TOKEN=

# --- OpenAI ---
OPENAI_API_KEY=
# Cheap model for classification, higher-quality model for drafting
OPENAI_CLASSIFY_MODEL=gpt-5-mini
OPENAI_DRAFT_MODEL=gpt-5

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price id of the monthly plan (~$19/mo, 7-day trial configured at checkout)
STRIPE_PRICE_ID=
# Set to "false" to bypass billing checks in local development
BILLING_ENABLED=false

# --- Resend (daily brief + transactional email) ---
RESEND_API_KEY=
BRIEF_FROM_EMAIL=MailPilot <brief@yourdomain.com>

# --- Inngest (leave empty for local dev; `npx inngest-cli dev`) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Cost guards (per user, per day) ---
MAX_DAILY_CLASSIFICATIONS=300
MAX_DAILY_DRAFTS=50
